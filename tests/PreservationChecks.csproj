<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PreservationChecks</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == ''">C:\Steam Games\steamapps\common\Sailwind</GameDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\SailwindFoodPreservation.csproj" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCore)\Mono.Cecil.dll" />
  </ItemGroup>
</Project>
